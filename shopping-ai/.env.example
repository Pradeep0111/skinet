APP_ENV=development
LOG_LEVEL=INFO
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=anthropic (implemented in Week 2).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=512

DOTNET_BASE_URL=https://localhost:5000
# Current .NET integration uses the same Assistant:ServiceKey in both directions.
DOTNET_SERVICE_KEY=
DOTNET_VERIFY_TLS=true
INTERNAL_SERVICE_KEY=replace-with-a-local-development-secret
CONVERSATION_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CONVERSATION_TTL_SECONDS=86400
CONVERSATION_MAX_MESSAGES=20
REQUEST_TIMEOUT_SECONDS=10
CHAT_TIMEOUT_SECONDS=20
MAX_MESSAGE_LENGTH=1000

# Week 7 hybrid retrieval is opt-in so normal startup never downloads a model.
# Install the semantic extra before enabling it: uv sync --extra dev --extra semantic
SEMANTIC_SEARCH_ENABLED=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Pin a 40-character model commit SHA and set local-only after pre-caching for deployment.
EMBEDDING_REVISION=
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_CACHE_PATH=.data/embedding-models
SEMANTIC_SEARCH_TIMEOUT_SECONDS=8
