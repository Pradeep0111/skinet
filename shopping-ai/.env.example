APP_ENV=development
LOG_LEVEL=INFO
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=anthropic (implemented in Week 2).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=512

DOTNET_BASE_URL=https://localhost:5000
# Required for real catalog calls; keep blank while using mocked Week 3 tests.
DOTNET_SERVICE_KEY=
DOTNET_VERIFY_TLS=true
INTERNAL_SERVICE_KEY=replace-with-a-local-development-secret
CONVERSATION_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CONVERSATION_TTL_SECONDS=86400
CONVERSATION_MAX_MESSAGES=20
REQUEST_TIMEOUT_SECONDS=10
MAX_MESSAGE_LENGTH=1000
